# ==========================================
# Personalized Study Coach - Environment Variables
# ==========================================

# ── Database Configuration ──
POSTGRES_USER=study_coach_user
POSTGRES_PASSWORD=study_coach_pass
POSTGRES_DB=study_coach_db

# ── Application Configuration ──
# CRITICAL: You MUST generate your own secure SECRET_KEY for production!
# The server will crash on startup if an insecure or default value is used.
# You can generate a secure key by running: openssl rand -hex 32
SECRET_KEY=generate_your_own_secure_secret_key_here
DEBUG=True

# ── Database Connection (Backend Internal) ──
# This URL is constructed using the variables above for docker-compose networking
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── AI Configuration Placeholders ──
OPENAI_API_KEY=your_openai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# ── Google Integration Placeholders ──
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Redis Placeholder (Optional for Phase 1) ──
REDIS_URL=redis://localhost:6379/0
