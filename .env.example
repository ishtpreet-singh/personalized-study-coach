# ==============================================================
# Personalized Study Coach — Environment Variables (.env.example)
# ==============================================================

# ── Application Configuration ──
APP_NAME="Personalized Study Coach"
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO

# CRITICAL: Generate a strong random key (>= 32 characters) for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_your_own_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL (required for email verification links and CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database Configuration ──
# Local Docker development:
POSTGRES_USER=study_coach_user
POSTGRES_PASSWORD=study_coach_pass
POSTGRES_DB=study_coach_db
DATABASE_URL=postgresql://study_coach_user:study_coach_pass@localhost:5432/study_coach_db

# Supabase Production connection pool (Render Free):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ── Vector Store Provider ──
# "chroma" for local ChromaDB HTTP container, "pgvector" for Supabase PostgreSQL pgvector
VECTOR_STORE_PROVIDER=chroma

# ── ChromaDB (Local Development fallback) ──
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=study_materials

# ── Supabase Storage (Production Document Files) ──
# Stored securely on the backend only; never exposed to client bundles
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=study_coach_documents

# ── Google Gemini AI (Required for Chat, Embeddings, Quizzes) ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=models/gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
LLM_PROVIDER=gemini

# ── NVIDIA NIM (Optional alternative) ──
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct

# ── Google OAuth & Calendar ──
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Email Service (Resend) ──
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Study Coach <noreply@studycoach.example.com>

# ── Redis (Token Blacklist - Optional) ──
REDIS_URL=redis://localhost:6379/0
