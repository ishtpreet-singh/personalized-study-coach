# =============================================
# Personalized Study Coach — Root .gitignore
# =============================================

# ─── Python ───────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.log

# ─── Node / Frontend ──────────────────────
node_modules/
dist/
.next/
.nuxt/
.output/
.cache/
frontend/.env
frontend/.env.local
frontend/.env.production

# ─── Environment & Secrets ────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ─── Databases & Volumes ──────────────────
*.sqlite3
*.db
postgres_data/
chroma_data/
uploads/

# ─── Docker ───────────────────────────────
.dockerignore

# ─── IDEs & Editors ───────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── AWS & Cloud ──────────────────────────
*.tfstate
*.tfstate.backup
.terraform/
aws_credentials

# ─── Logs ─────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Testing ──────────────────────────────
coverage/
.nyc_output/
